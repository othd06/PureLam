;define div (Y (\d.\m.\n.If-Then (Lt Church-Nat m n) False (Succ Church-Nat (d (Sub Church-Nat m n) n))));

;;
Cmp Church-Nat `0 `0    ; Equal;
Cmp Church-Nat `0 `1    ; Less;
Cmp Church-Nat `1 `0    ; Greater;
Cmp Church-Nat `1 `1    ; Equal;
Cmp Church-Nat `1 `2    ; Less;
Cmp Church-Nat `2 `1    ; Greater;
Cmp Church-Nat `2 `2    ; Equal;
Cmp Church-Nat `2 `3    ; Less;
Cmp Church-Nat `3 `2    ; Greater;
Cmp Church-Nat `5 `5    ; Equal;
Cmp Church-Nat `5 `6    ; Less;
Cmp Church-Nat `6 `5    ; Greater;
Cmp Church-Nat `10 `10  ; Equal;
Cmp Church-Nat `10 `7   ; Greater;
Cmp Church-Nat `7 `10   ; Less;
Cmp Church-Nat `15 `3   ; Greater;
Cmp Church-Nat `3 `15   ; Less;
;;

